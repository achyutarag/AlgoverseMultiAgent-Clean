# .env.example
# Copy this file to .env and fill in your actual values
# DO NOT commit your actual .env file to git (it's in .gitignore)

# Google Gemini API Key (Primary method - Recommended)
# Get your API key from: https://makersuite.google.com/app/apikey
# Or visit: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OR use Service Account (Alternative method)
# Download service account key JSON file from Google Cloud Console
# Then uncomment and set the path below:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Note: The code will try GOOGLE_API_KEY first, then fall back to GOOGLE_APPLICATION_CREDENTIALS
# You only need to set one of these, not both.
